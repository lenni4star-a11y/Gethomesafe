# Kopiere diese Datei zu ".env" und trage deinen Mapillary Client Token ein.
# Die Datei ".env" wird nie ins Repository hochgeladen.
# Token erstellen: https://www.mapillary.com/dashboard/developers ("Client Token", beginnt mit MLY|)
VITE_MAPILLARY_TOKEN=

# Supabase (Frankfurt) für den Live-Standort-Link – siehe supabase/ANLEITUNG.md
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
